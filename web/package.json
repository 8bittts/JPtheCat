{
	"name": "jpthecat-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": "24.x"
	},
	"description": "JP the Cat — the cat that counts your agent tokens. Marketing site.",
	"scripts": {
		"dev": "lsof -ti:4444 | xargs kill -9 2>/dev/null || true && rm -rf .next && next dev -p 4444",
		"build": "next build && bun run check:perf-budget && bun run scan:client-secrets",
		"check:perf-budget": "bun scripts/perf-budget.ts",
		"scan:client-secrets": "bun run scripts/scan-client-bundle-secrets.ts",
		"start": "next start -p 4444",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"type-check": "tsc --noEmit",
		"check": "bun run lint && bun run type-check",
		"test": "bun test",
		"a11y": "bun scripts/a11y-audit.ts",
		"knip": "knip",
		"doctor": "react-doctor . --verbose --blocking warning",
		"doctor:diff": "react-doctor . --verbose --scope changed --base main",
		"check:full": "bun run check && bun run test && bun run knip && bun run doctor && bun run build"
	},
	"dependencies": {
		"@react-email/components": "^1.0.12",
		"@vercel/analytics": "2.0.1",
		"@vercel/speed-insights": "2.1.0",
		"next": "^16.4.6",
		"postgres": "^4.1.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"resend": "^6.38.1",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.7",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.187.0",
		"knip": "^6.45.1",
		"postcss": "^8.5.33",
		"react-doctor": "0.9.23",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"minimatch": "11.0.5"
	}
}
