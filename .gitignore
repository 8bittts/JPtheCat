# macOS
.DS_Store

# Node / Next (web/ has its own .gitignore too)
node_modules/
.next/
out/
*.tsbuildinfo

# SwiftPM build output. mac/.gitignore already covers mac/; this bare pattern
# matches at any depth, so a stray `swift build` from the repo root cannot
# leave an untracked .build/ behind.
.build/

# Env & secrets
.env
.env*
!.env.example
*.pem
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile

# Release artifacts are uploaded to storage, never committed
*.dmg

# Local agent state; the runbooks under .claude/ and .agents/ are tracked
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Operator-local private data: the customer-data archive
_docs/legacy-backup/

# Logs
*.log

# Python scratch
__pycache__/
*.pyc

# Operator-local brand masters: generated video renders and real photos of JP
brand/generated/
brand/reference/

# Editor
.vscode/
.idea/

# Local task worktrees. These are intentionally rooted under the canonical checkout.
workstreams/
.worktrees/

.vercel

# Supabase CLI scratch (project-ref cache written during functions deploy)
supabase/.temp/

